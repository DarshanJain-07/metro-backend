# Django core configuration
DJANGO_SECRET_KEY=generate_a_secure_random_key_here
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CORS_ORIGINS=http://localhost:3000

# Django/PostgreSQL configuration
# Copy this file to .env and fill in client-specific values before running the app.

METRO_DB_NAME=client_database_name
METRO_DB_USER=postgres
METRO_DB_PASSWORD=change_me
METRO_DB_HOST=localhost
METRO_DB_PORT=5432

# Redis cache/throttle backend
DJANGO_USE_REDIS_CACHE=False
REDIS_URL=redis://127.0.0.1:6379/1

# JWT token lifetimes
JWT_ACCESS_TOKEN_MINUTES=30
JWT_REFRESH_TOKEN_DAYS=7

# WorkOS AuthKit/User Management
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
WORKOS_REDIRECT_URI=http://localhost:3000/auth/callback
WORKOS_FRONTEND_CALLBACK_URL=http://localhost:3000/auth/callback
WORKOS_GOOGLE_STATE_TTL_SECONDS=600
WORKOS_GOOGLE_EXCHANGE_TTL_SECONDS=300
WORKOS_AUTO_PROVISION_USERS=False
# Optional JSON override, for example: {"custom-role":"BRANCH_ADMIN"}
WORKOS_ROLE_MAPPING={}

# Built-in Metro owner initialized by init_db.sh / ensure_metro_owner.
METRO_OWNER_USERNAME=metro
METRO_OWNER_EMAIL=metroexpress456@gmail.com
METRO_OWNER_COMPANY_NAME=Metro Logistics

# Format for auto-generating docket numbers. 
# Available placeholders: {YY}, {YYYY}, {MM}, {DD}, {SEQ:N} (where N is the zero-padded length)
DOCKET_FORMAT=D{YY}{MM}{DD}{SEQ:4}
