# Django core configuration
DJANGO_SECRET_KEY=generate_a_secure_random_key_here
DJANGO_DEBUG=True
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# Django/PostgreSQL configuration
# Copy this file to .env and fill in client-specific values before running the app.
DATABASE_URL=postgresql://postgres:change_me@localhost:5432/client_database_name
# Optional, only if reads should use a separate database.
# REPLICA_DATABASE_URL=postgresql://postgres:change_me@localhost:5432/client_database_name

# Redis cache/throttle backend
REDIS_URL=redis://127.0.0.1:6379/1

# WorkOS AuthKit/User Management
WORKOS_API_KEY=sk_test_replace_me
WORKOS_CLIENT_ID=client_replace_me
